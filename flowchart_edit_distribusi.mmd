%% ============================================================
%% FLOWCHART EDIT DISTRIBUSI (SURAT JALAN)
%% Dokumen analisis integritas data saat edit distribusi
%% ============================================================
%% File ini berisi 3 diagram:
%% 1. MAIN FLOW — Alur lengkap proses edit
%% 2. CONTOH KONKRET — Skenario edit 10 → 8 Ton
%% 3. DAMPAK PER ENTITAS — Apa yang berubah di setiap tabel
%% ============================================================

%% ============================================================
%% DIAGRAM 1: MAIN FLOW — Alur Lengkap Edit Distribusi
%% ============================================================

flowchart TD
    START(["👤 Superadmin klik tombol Edit<br/>di halaman Distribusi"])
    START --> LOAD["📥 <b>Load Data</b><br/>Distribution + existing items<br/>Snapshot: old_kios_id, old_year"]

    LOAD --> FORM["📝 User mengubah data<br/>(kios, tanggal, armada, item pupuk)"]
    FORM --> SUBMIT{{"Submit Form"}}

    SUBMIT --> VALID_FORM{"Form & Formset<br/>valid?"}
    VALID_FORM -- "❌ Tidak" --> ERR_FORM["Tampilkan error validasi<br/>Kembali ke form"]

    VALID_FORM -- "✅ Ya" --> VALID_STOCK["<b>validate_distribution_items</b><br/>Cek stok virtual, fisik, kuota<br/>dengan offset existing_items"]
    VALID_STOCK -- "❌ Gagal" --> ERR_STOCK["Tampilkan pesan error<br/>(stok/kuota tidak cukup)"]

    VALID_STOCK -- "✅ Lulus" --> SNAPSHOT["📸 Snapshot Sebelum Save:<br/>old_kios_id = dist.kios_id<br/>old_year = dist.date.year"]

    SNAPSHOT --> ATOMIC["🔒 <b>BEGIN transaction.atomic()</b>"]

    subgraph TX ["🔒 TRANSAKSI ATOMIC — Semua atau Tidak Sama Sekali"]
        direction TB

        ATOMIC --> SAVE_HDR["<b>1. SAVE HEADER</b><br/>Distribution.save()"]

        SAVE_HDR --> SIG_PRE_DIST["⚡ Signal: <b>pre_save Distribution</b><br/>Cache _old_dist_state<br/>(old kios, jenis, tonnage, SO)"]
        SIG_PRE_DIST --> SIG_POST_DIST["⚡ Signal: <b>post_save Distribution</b><br/>✓ update_stock_from_distribution → <b>SKIP</b><br/>(items.exists = True, per-item aktif)<br/>✓ create_invoice_automatis → <b>QUEUE on_commit</b>"]

        SIG_POST_DIST --> SAVE_ITEMS["<b>2. SAVE ITEMS</b><br/>formset.save()"]

        SAVE_ITEMS --> BRANCH{"Jenis Perubahan<br/>per Item"}

        %% ── MODIFIED ITEM ──
        BRANCH --> MOD["✏️ <b>Item DIUBAH</b><br/>(tonase/jenis/SO berubah)"]
        MOD --> MOD_PRE["⚡ pre_save DistributionItem:<br/>1. Cache old_state (jenis, ton, source)<br/>2. Jika jenis berubah → reset price snapshot<br/>3. Isi price snapshot dari master harga"]
        MOD_PRE --> MOD_POST["⚡ post_save DistributionItem:<br/>1. Update StockCard (update_or_create)<br/>2. Restore old kuota: +old_ton<br/>3. Apply new kuota: -new_ton<br/>4. recompute_stock_balance<br/>5. update_so_closure (jika Virtual)"]

        %% ── DELETED ITEM ──
        BRANCH --> DEL["🗑️ <b>Item DIHAPUS</b>"]
        DEL --> DEL_POST["⚡ post_delete DistributionItem:<br/>1. Hapus StockCard (3 kartu per item)<br/>2. Restore kuota: +tonnage<br/>3. recompute_stock_balance<br/>4. update_so_closure (jika Virtual)"]

        %% ── NEW ITEM ──
        BRANCH --> NEW["➕ <b>Item BARU</b>"]
        NEW --> NEW_PRE["⚡ pre_save DistributionItem:<br/>1. old_state = None (baru)<br/>2. Isi price snapshot dari master harga"]
        NEW_PRE --> NEW_POST["⚡ post_save DistributionItem:<br/>1. Create StockCard baru<br/>2. Validasi stok cukup (safety net)<br/>3. Apply kuota: -tonnage<br/>4. recompute_stock_balance<br/>5. update_so_closure (jika Virtual)"]

        %% ── UNCHANGED ITEM ──
        BRANCH --> UNCH["⏸️ <b>Item TIDAK BERUBAH</b><br/>(tidak ada signal yang terpicu)"]

        %% ── QUOTA CORRECTION ──
        MOD_POST --> CORRECT
        DEL_POST --> CORRECT
        NEW_POST --> CORRECT
        UNCH --> CORRECT

        CORRECT{"Kios atau Tahun<br/>berubah?"}
        CORRECT -- "Tidak berubah" --> COMMIT["✅ <b>COMMIT</b>"]
        CORRECT -- "⚠️ Ya, berubah!" --> FIX["🔧 <b>KOREKSI KUOTA</b><br/>Untuk setiap old_item:<br/>• old_kios.quota += tonnage<br/>• new_kios.quota −= tonnage<br/><br/><i>Memperbaiki signal yang salah</i><br/><i>me-restore ke kios/tahun baru</i>"]
        FIX --> COMMIT
    end

    COMMIT --> ONCOMMIT["🔄 <b>After COMMIT (on_commit)</b><br/>_upsert_invoice():<br/>• Hitung ulang total dari semua items<br/>• Update issue_date = pkp_date<br/>• Update due_date = pkp_date + 3 hari"]

    ONCOMMIT --> SUCCESS(["✅ Redirect ke list<br/>Pesan: Surat Jalan berhasil diperbarui"])
