%% DIAGRAM 2: CONTOH KONKRET — Edit 10 Ton → 8 Ton (Sumber Fisik)
%% ============================================================
%% Untuk render diagram ini, salin ke editor Mermaid terpisah

%% ```mermaid
%% sequenceDiagram
%%     autonumber
%%     participant U as 👤 Superadmin
%%     participant V as 🖥️ View
%%     participant PS as ⚡ pre_save Signal
%%     participant S as ⚡ post_save Signal
%%     participant SC as 📊 StockCard
%%     participant Q as 📋 Kuota Kios
%%     participant I as 💰 Invoice
%%
%%     Note over SC,Q: ═══ SEBELUM EDIT ═══
%%     Note over SC: Physical OUT = 10 Ton
%%     Note over Q: quota_remaining = 20<br/>(awalnya 30, sudah terpotong 10)
%%     Note over I: total_amount = 10 × Rp50.000 = Rp500.000
%%
%%     U->>V: Edit: tonnage 10 → 8 Ton
%%     V->>V: validate_distribution_items<br/>(stok fisik + offset +10 = cukup ✓)
%%
%%     rect rgb(240, 248, 255)
%%         Note over V,I: 🔒 transaction.atomic()
%%         V->>V: Snapshot old_kios_id
%%         V->>V: Distribution.save() (header)
%%
%%         V->>PS: DistributionItem.save()
%%         PS->>PS: Cache old_state<br/>{tonnage: 10, jenis: NPK}
%%         PS->>PS: Price snapshot tetap<br/>(jenis tidak berubah)
%%
%%         PS->>S: post_save fired
%%         S->>SC: update_or_create StockCard<br/>qty_out: 10 → 8
%%         S->>SC: recompute_stock_balance<br/>Balance: −10 → −8
%%         S->>Q: Restore old: quota += 10<br/>(20 + 10 = 30)
%%         S->>Q: Apply new: quota −= 8<br/>(30 − 8 = 22)
%%
%%         V->>V: Kios berubah? Tidak → skip koreksi
%%     end
%%
%%     V->>I: on_commit: _upsert_invoice
%%     I->>I: Hitung ulang total<br/>= 8 × Rp50.000 = Rp400.000
%%
%%     Note over SC,Q: ═══ SETELAH EDIT ═══
%%     Note over SC: Physical OUT = 8 Ton ✅<br/>Balance = −8 ✅
%%     Note over Q: quota_remaining = 22 ✅<br/>(+2 kembali ke kuota)
%%     Note over I: total_amount = Rp400.000 ✅<br/>(turun Rp100.000)
%% ```

